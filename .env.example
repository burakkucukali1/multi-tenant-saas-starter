# Copy to `.env.local` for local development (never commit `.env.local`).
# P0-T17 — dev and CI Supabase credentials (ADR-0041 §10). No production secrets.
# Setup: docs/runbooks/secrets-dev-ci.md

# ==========================================
# APP
# ==========================================

NODE_ENV=development
LOG_LEVEL=debug
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# SUPABASE DEV (<app>-dev)
# ==========================================

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_DEV_PROJECT_REF.supabase.co
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres.YOUR_DEV_PROJECT_REF:YOUR_ENCODED_PASSWORD@YOUR_POOLER_HOST:6543/postgres

# Personal PAT for local `supabase` CLI only — never store personal PATs in GitHub Actions.
SUPABASE_ACCESS_TOKEN=

# ==========================================
# SUPABASE CI (<app>-ci)
# ==========================================

SUPABASE_CI_PROJECT_REF=
SUPABASE_CI_DB_PASSWORD=
SUPABASE_CI_SERVICE_ROLE_KEY=
SUPABASE_TEST_DATABASE_URL=postgresql://postgres.YOUR_CI_PROJECT_REF:YOUR_ENCODED_PASSWORD@YOUR_POOLER_HOST:6543/postgres

# ==========================================
# CLERK (P3+)
# ==========================================

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# ==========================================
# STRIPE (P5+)
# ==========================================

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ==========================================
# EMAIL (FUTURE)
# ==========================================

RESEND_API_KEY=
